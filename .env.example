# =============================================================================
# Telegram MCP 환경 변수 템플릿
# 로컬 테스트: cp .env.example .env
# 프로덕션: cp .env.example .env.production.{1,2} (deploy 스크립트가 서버에 .env.{1,2}로 복사)
# docker --env-file은 따옴표를 리터럴로 포함시키므로 따옴표 사용 금지
#
# 2인스턴스 구조: 같은 이미지, 서로 다른 Telegram 계정
# =============================================================================

# ── 시스템 ────────────────────────────────────────────
# 타임존 (대한민국 표준시)
TZ=Asia/Seoul

# 로케일 (UTF-8 인코딩 보장)
LANG=C.UTF-8

# ── Telegram API ──────────────────────────────────────
# https://my.telegram.org/apps 에서 발급
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# ── 세션 관리 ─────────────────────────────────────────
# 파일 기반: .session 파일 생성됨
#TELEGRAM_SESSION_NAME=telegram_session
# 문자열 기반: session_string_generator.py로 생성
TELEGRAM_SESSION_STRING=

# ── SSE 보안 ──────────────────────────────────────────
# 쉼표 구분, --transport sse 모드 전용
# 둘 다 비어 있으면 DNS rebinding 보호 비활성화 (리버스 프록시 뒤에서 안전)
#MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*
#MCP_ALLOWED_ORIGINS=
