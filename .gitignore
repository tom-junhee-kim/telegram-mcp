# 환경 변수 (비밀 정보 — 커밋 금지)
.env*
!.env.example

# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
uv.lock
poetry.lock

# Telegram 세션 (런타임 생성)
*.session
*.session-journal

# 로그 (런타임 생성, 서버에만 존재)
logs/

# 임시 파일
*.tmp
*.log
mcp_errors.log

# OS 시스템 생성 파일 (GitHub 공식 gitignore 템플릿 기반)
# macOS
.DS_Store
._*
.AppleDouble
.LSOverride
# Windows
Thumbs.db
Thumbs.db:encryptable
[Dd]esktop.ini
# Linux
*~
.directory
